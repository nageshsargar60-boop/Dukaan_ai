# DukaanAI Web Application Environment Variables
# Copy to .env.local for local development. Do not commit actual secrets.

# Application Configuration
NEXT_PUBLIC_APP_NAME="DukaanAI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

# DukaanAI Express Backend API (planned / existing)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# AI Inference Service (Local Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# Server Configuration
PORT=3000
NODE_ENV="development"
